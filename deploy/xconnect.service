[Unit]
Description=XConnect — Pow3rtool data-plane broker + Caller ingress
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Dedicated unprivileged user — NOT root. The broker binds tcp/3 (privileged),
# so the ONLY capability granted is CAP_NET_BIND_SERVICE; everything else is
# dropped. One-time setup:
#   useradd --system --no-create-home --shell /usr/sbin/nologin xconnect
#   install -d -o xconnect -g xconnect -m 750 /etc/xconnect
#   # place the service cert/key + xconnect.env under /etc/xconnect (0640, owned xconnect)
User=xconnect
Group=xconnect
WorkingDirectory=/nfs/pow3rtool/XConnect
# Site-specific config (tenant/audience/control-url) comes from the env file so
# the binary stays generic. Copy xconnect.env.example -> /etc/xconnect/xconnect.env.
EnvironmentFile=/etc/xconnect/xconnect.env
# --etc points at the LOCAL identity dir (copy the service cert/key + ca-bundle to
# /etc/xconnect, owned by the xconnect user, key 0600) — never depend on a shared
# mount for the data plane's own identity. control-url + audience come from the env.
ExecStart=/nfs/pow3rtool/XConnect/xconnect --heartbeat 20s --bootstrap-bin-dir /nfs/pow3rtool/RCON/dist --etc /etc/xconnect serve
Restart=on-failure
RestartSec=5s

# --- least privilege: bind tcp/3 only, nothing else ------------------------
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
UMask=0077
# /run/xconnect for the (off-by-default) admin API unix socket (admin.sock, 0600).
RuntimeDirectory=xconnect
RuntimeDirectoryMode=0750

# --- sandbox ---------------------------------------------------------------
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Broker + control link + Caller are all TCP; the admin socket is AF_UNIX.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# --- resource ceilings (a runaway kills only the service, not the host) ----
MemoryMax=1G
TasksMax=512
LimitCORE=0

[Install]
WantedBy=multi-user.target
