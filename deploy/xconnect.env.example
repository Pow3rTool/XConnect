# XConnect deployment config — site-specific values pulled out of source so the
# binary carries no hardcoded tenant/audience/host. Install as an EnvironmentFile
# (e.g. /etc/xconnect/xconnect.env, chmod 600) and reference it from the unit.

# Entra tenant whose tokens XConnect validates (drives the JWKS + issuer check).
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Expected token audience — the XConnect API app-reg's appId GUID (and/or its
# App ID URI). Comma-separated to accept more than one form.
XCONNECT_AUDIENCE=00000000-0000-0000-0000-000000000000

# Orthanc control listener (mTLS) this broker dials up to.
XCONNECT_CONTROL_URL=https://orthanc.example.com:8443

# Expected control-server SPIFFE id (pin). Default matches the project trust
# domain; override if yours differs.
# XCONNECT_CONTROL_SERVER_ID=spiffe://pow3rtool/system/orthanc-control

# Token validation mode: entra (RS256 via JWKS) or dev (HS256 test tokens).
XCONNECT_AUTH_MODE=entra
# Only for auth-mode=dev (headless testing). Leave unset in production.
# XCONNECT_DEV_SECRET=

# Native desktop is enabled for Windows nodes advertising desktop capability.
# Set false to disable all desktop routes; existing full authorization is required.
# XCONNECT_DESKTOP_ENABLED=true
# Optional model grounding; observation and explicit gestures work without Nexus.
# XCONNECT_DESKTOP_NEXUS_URL=https://nexus.example.com/v1
# XCONNECT_DESKTOP_NEXUS_KEY_FILE=/etc/xconnect/desktop-nexus.key
# Keep the key private/readable by the service account. Grant only gui-grounder.
